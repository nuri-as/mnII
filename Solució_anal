import matplotlib.pyplot as plt
import numpy as np


#constants i més
T_cos = 36.5+273 #K, temperatura inicial i a la frontera
z = 0.56 #W/(m*K)
cv = 3698 #J/(kg*K)
rho = 1081 #kg/m^3
sigma = 0.472 #S/m
alpha = z/(cv*rho)
Delta_V = 40 #V
t_max=0.025
N=101

#Constants de normalització
T0 = sigma * (Delta_V)**2 / (2*z)
d = 0.02 #m, gruix de paret entre els ventricles
t0 = d**2/alpha

# Definim la funció per calcular la solució analítica amb les variables normalitzades:
def T_analitica(x_tilde, t_tilde, Tcos, T0, n_termes):
  T= Tcos / T0 #terme de fora del sumatori

  #fem un for per calcular el sumatori:
  for n in range(1, n_termes + 1):
    p=(2*n-1)*np.pi
    ter_temp = (1.0 - np.exp(-(p**2) * t_tilde)) / (p**2)
    ter_pos = np.sin(p * x_tilde)

    T+= (4/p * ter_temp * ter_pos)
  return T

#Gràfica de la solució analítica en funció de la distància x per l'instant tmax = 0.025
x_espai=np.linspace(0, 1, N)  # Espai normalitzat
T_anal = T_analitica(x_espai, t_max, T_cos, T0,300)

#"Desnormalitzant, simplement haurem de fer T=T0 * T_tilde (i això per x i t també)
T_desnorm = T_anal*T0
x_desnorm = x_espai*d
t_desnorm = t_max*t0

plt.plot(x_desnorm, T_desnorm, color="royalblue", linewidth=2)

plt.title(rf"Perfil de temperatura a $t_a \approx {t_desnorm:.2f}$ s")
plt.xlabel("x (m)")
plt.ylabel("T (k)")

plt.grid(True, alpha=0.3)
plt.show()



